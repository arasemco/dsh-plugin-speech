{
  "name": "dsh-plugin-speech",
  "description": "Read replies aloud and dictate prompts: OpenAI-compatible speech through the profile's configured model providers",
  "version": "0.1.7",
  "private": true,
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./tts": "./tts/index.js",
    "./stt": "./stt/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "tts/index.js",
    "stt/index.js",
    "lib/audio.js",
    "lib/client.js",
    "lib/http.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "engines": {
    "dsh": "0.2.2-rc.1"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:live": "node --test test/live.test.mjs"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
